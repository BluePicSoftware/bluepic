{
  "compilerOptions": {
    "moduleResolution": "Node",
    "target": "ES2019",
    "module": "ES2015",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./lib/esm",
    "declarationDir": "./lib/esm/types",
    "declaration": true,
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["./src"],
  "exclude": ["tests"]
}
